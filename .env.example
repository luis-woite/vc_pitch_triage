# Copy this file to ".env" and fill in your real keys.
# Never commit the real ".env" file — it's already in .gitignore.

# Required — the vision extraction step (Phase 2) calls Claude on slide images.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_key_here

# Optional — only needed for Phase 4 (GitHub-based external grounding for
# dev-tool/open-source startups). Unauthenticated GitHub API calls work but
# have a low rate limit; a personal access token raises it substantially.
# Create one at https://github.com/settings/tokens (no special scopes needed
# for public repo read access).
GITHUB_TOKEN=your_token_here
